	column Date
		formatString: Short Date
		lineageTag: 4615f688-fa2f-42a7-83b8-3694bca3f4fd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variación
			isDefault
			relationship: 202cc0a1-ad58-4fc2-adef-8bc7e811110a
			defaultHierarchy: LocalDateTable_8be2d559-8221-4867-8ac2-22b4b22b07c5.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

	column 'Semana del Mes' = ```
			
			VAR PrimerDiaMes = DATE(YEAR('Fecha'[Date]), MONTH('Fecha'[Date]), 1)
			VAR NumeroSemana = WEEKNUM('Fecha'[Date], 2) - WEEKNUM(PrimerDiaMes, 2) + 1
			RETURN 
			"Semana " & NumeroSemana
			```
