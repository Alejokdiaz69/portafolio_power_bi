	column ANS = LOOKUPVALUE('ANS de Entrega'[Días],'ANS de Entrega'[Tipo de transito],Ventas_2[Tipo de Transito])
		formatString: 0
		lineageTag: 137e1cae-c3d7-480d-b52d-a743004879e1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Tipo de Transito' =
			
			IF(IF(
			    LOOKUPVALUE(WMS[DESTINO],WMS[Pedido_Factura],Ventas_2[cust_order_id])="",
			    Ventas_2[ALTERNATIVA],
			    LOOKUPVALUE(WMS[DESTINO],WMS[Pedido_Factura],Ventas_2[cust_order_id]))="","Sin Tipo de Transito",IF(
			    LOOKUPVALUE(WMS[DESTINO],WMS[Pedido_Factura],Ventas_2[cust_order_id])="",
			    Ventas_2[ALTERNATIVA],
			    LOOKUPVALUE(WMS[DESTINO],WMS[Pedido_Factura],Ventas_2[cust_order_id])))
		lineageTag: 0bdd1bc1-f6b0-427d-a316-a0f09838b7a5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Estado de Orden' = IF(IF(LOOKUPVALUE(WMS[Estado2],WMS[Pedido_Factura],Ventas_2[cust_order_id])="",Ventas_2[Tipo de Transito],LOOKUPVALUE(WMS[Estado2],WMS[Pedido_Factura],Ventas_2[cust_order_id]))="","Sin Estado de Orden",IF(LOOKUPVALUE(WMS[Estado2],WMS[Pedido_Factura],Ventas_2[cust_order_id])="",Ventas_2[Tipo de Transito],LOOKUPVALUE(WMS[Estado2],WMS[Pedido_Factura],Ventas_2[cust_order_id])))
		lineageTag: fcf58fcb-7ac0-40d2-9df9-4c94bc8d2aad
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Subestado = IF(LOOKUPVALUE(WMS[Subestado],WMS[Pedido_Factura],ventas_2[cust_order_id])="","Sin Subestado",LOOKUPVALUE(WMS[Subestado],WMS[Pedido_Factura],ventas_2[cust_order_id]))
		lineageTag: e8e4378f-5a32-463b-b798-6298737dc8a3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DiasCalculados =
			
			VAR FechaCreacion = [fecha_creacion_orden]
			VAR FechaCompletada = [completed_date].[Date]
			VAR Hoy = TODAY()
			VAR PrimerDiaMesActual = DATE(YEAR(Hoy), MONTH(Hoy), 1)
			VAR PrimerDiaCreacion = DATE(YEAR(FechaCreacion), MONTH(FechaCreacion), 1)
			VAR Dias =
			    IF(
			        NOT(ISBLANK(FechaCreacion)) && NOT(ISBLANK(FechaCompletada)),
			        0,
			        IF(
			            FechaCreacion < (PrimerDiaMesActual - 60),
			            DATEDIFF(FechaCreacion, PrimerDiaCreacion + 60, DAY),
			            DATEDIFF(FechaCreacion, PrimerDiaMesActual, DAY)
			        )
			    )
			RETURN
			MAX(Dias, 0)
		formatString: 0
		lineageTag: d334487e-e50f-4e25-bac8-688f5a79e03a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Promesa de entrega' = ```
			
			IFERROR(
			    IF(
			    Ventas_2[ANS]<Ventas_2[DiasCalculados],
			    "Excede tiempo promesa",
			    "Cumple ANS de entrega"),
			    Ventas_2[ALTERNATIVA])
			    
			```
		lineageTag: c2851a5f-5b9e-40ca-9a8b-eb414970f567
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Tipo de rechazo' =
			
			IF(
			    OR(Ventas_2[estado_orden]="Reject",
			    OR(Ventas_2[estado_orden]="ABD Reject",
			    Ventas_2[estado_orden]="Send out"))
			    ,IF(
			    IF(
			    OR(Ventas_2[estado_orden]="Reject",Ventas_2[estado_orden]="ABD Reject"),
			    LOOKUPVALUE(Rechazos[TIPIFICACION_PRINCIPAL],Rechazos[PORT_NUMBER],Ventas_2[linea]),
			    Ventas_2[estado_orden])="",
			    "Rechazo no especificado",
			    IF(
			    OR(Ventas_2[estado_orden]="Reject",Ventas_2[estado_orden]="ABD Reject"),
			    LOOKUPVALUE(Rechazos[TIPIFICACION_PRINCIPAL],Rechazos[PORT_NUMBER],Ventas_2[linea]),
			    Ventas_2[estado_orden])),
			    "")
		lineageTag: 49a0b0cd-c32c-46c7-b790-6369845b2fe0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

