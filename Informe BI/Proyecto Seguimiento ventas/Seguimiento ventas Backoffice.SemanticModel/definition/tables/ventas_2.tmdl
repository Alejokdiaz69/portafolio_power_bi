	measure %Activo_ventas =
			
			DIVIDE(SUM(ventas_2[venta_completada]), SUM(ventas_2[Unic]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: cf896069-1654-4f2f-99ba-c99b8d3d9eb2

	measure %Transito =
			
			DIVIDE(SUM(ventas_2[Ventas en transito]), SUM(ventas_2[Unic]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 93fc1b33-f413-453d-bf1d-5a4428e003de

	measure %Rechazo_ventas =
			
			DIVIDE(SUM(ventas_2[Rechazo]), SUM(ventas_2[Unic]))
