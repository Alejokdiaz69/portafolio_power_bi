table 'Tabla cruce'
	lineageTag: 33c62eef-3125-47bb-a072-c21968058487

	measure '%Conv N' =
			
			DIVIDE(
				SUM('Tabla cruce'[Ventas mismo mes]),
				SUM('Tabla cruce'[ventas cantadas])
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 440d6700-808b-4cbf-af52-80abe0390d07

	measure '%Conv N+1' =
			
			DIVIDE(SUM('Tabla cruce'[Activa]), SUM('Tabla cruce'[ventas cantadas]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 4ad14fb6-9b54-4950-8d23-318550f5ed23

	measure '% Conv Arrastre' =
			
			DIVIDE([Medida], SUM('Tabla cruce'[ventas cantadas]))
