	column 'Venta cantadas'
		formatString: 0
		lineageTag: 6e04c594-b108-47a7-b3a9-cd0335314a8d
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Venta cantadas]

		annotation SummarizationSetBy = Automatic

	column Cuartil =
			
			VAR MesActual = 'Tabla cuartil semana'[Mes]
			VAR Jerarquia =
			    RANKX(
			        FILTER(
			            ALL('Tabla cuartil semana'),
			            'Tabla cuartil semana'[Mes] = MesActual
			        ),
			        'Tabla cuartil semana'[SPH 2],
			        ,
			        DESC,
			        DENSE
			    )
			VAR TotalContar =
			    COUNTROWS(
			        FILTER(
			            ALL('Tabla cuartil semana'),
			            'Tabla cuartil semana'[Mes] = MesActual
			        )
			    )
			VAR Porcentaje = DIVIDE(Jerarquia, TotalContar)
			RETURN
			    IF(
			        ISBLANK('Tabla cuartil semana'[SPH 2]),
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            Porcentaje > 0.75, "Q4",
			            Porcentaje <= 0.25, "Q1",
			            Porcentaje > 0.25 && Porcentaje <= 0.50, "Q2",
			            Porcentaje > 0.50 && Porcentaje <= 0.75, "Q3"
			        )
			    )
		lineageTag: 1580a983-008a-4322-ad84-187c8ff9b4a9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'SPH activo' = DIVIDE('Tabla cuartil semana'[Venta completada],'Tabla cuartil semana'[Tiempo logeado])
