		summarizeBy: sum
		isNameInferred
		sourceColumn: [Venta cantadas]

		annotation SummarizationSetBy = Automatic

	column 'SPH 2' = DIVIDE('Tabla cuartil mes'[Venta cantadas],'Tabla cuartil mes'[Tiempo logeado])
		formatString: 0.00
		lineageTag: ce2de4d0-7c1d-4b9c-a8b6-fdacb7f5611f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Cuartil =
			
			VAR MesActual = 'Tabla cuartil mes'[Mes]
			VAR Jerarquia =
			    RANKX(
			        FILTER(
			            ALL('Tabla cuartil mes'),
			            'Tabla cuartil mes'[Mes] = MesActual
			        ),
			        'Tabla cuartil mes'[SPH 2],
			        ,
			        DESC,
			        DENSE
			    )
			VAR TotalContar =
			    COUNTROWS(
			        FILTER(
			            ALL('Tabla cuartil mes'),
			            'Tabla cuartil mes'[Mes] = MesActual
			        )
			    )
			VAR Porcentaje = DIVIDE(Jerarquia, TotalContar)
			RETURN
			    IF(
			        ISBLANK('Tabla cuartil mes'[SPH 2]),
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            Porcentaje > 0.75, "Q4",
			            Porcentaje <= 0.25, "Q1",
			            Porcentaje > 0.25 && Porcentaje <= 0.50, "Q2",
			            Porcentaje > 0.50 && Porcentaje <= 0.75, "Q3"
			        )
			    )
		lineageTag: 9ab83f2c-f3a8-45d4-abbd-5a5c15cc6b6b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

